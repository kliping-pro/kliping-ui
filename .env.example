# Salin jadi `.env` untuk pengembangan lokal. `.env` tidak ikut di-commit.
#
# Dua nilai ini yang menggantikan URL yang sebelumnya ditulis langsung di dalam
# komponen. Tidak boleh ada satu pun alamat kliping.pro yang tertulis di berkas
# `.vue` atau `.ts` — semuanya lewat sini.

VITE_APP_URL=https://kliping.pro
VITE_REGISTRY_URL=https://kliping.pro/r
