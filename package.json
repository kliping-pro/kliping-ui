    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "generate:api": "node scripts/generate-api-reference.mjs",
    "generate:usage-docs": "node scripts/generate-usage-docs.mjs",
    "check": "npm run check:lockfile && npm run typecheck && npm run check:sfc && npm run check:registry && npm run check:strict && npm run check:language && npm run check:commands && npm run check:counts && npm run measure:bundle && npm run test && npm run cli:typecheck && npm run cli:test",
